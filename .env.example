# NUVAIX GROUP website - environment variables
#
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.
#
# This file only documents variables required by the current foundation.
# Variables for email, analytics, payments, or a CMS/database will be added
# in the milestones that actually introduce those integrations.

# Public base URL of the site. Used for metadata (canonical URLs, Open Graph).
# Falls back to http://localhost:3000 in development if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
