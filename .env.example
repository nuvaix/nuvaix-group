# NUVAIX GROUP website - environment variables
#
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.
#
# This file only documents variables required by the current foundation.
# Variables for analytics, payments, or a CMS/database will be added in the
# milestones that actually introduce those integrations.

# Public base URL of the site. Used for metadata (canonical URLs, Open Graph).
# Falls back to http://localhost:3000 in development if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact/enquiry form (Milestone 14, lib/actions/enquiry.ts, lib/email/).
# No email provider has been approved yet, so both variables below are
# intentionally left blank. Until both are set, the enquiry Server Action
# fails safely with a configuration_error result and no email is sent; no
# form data is lost silently, and nothing is invented in place of these.
# EMAIL_PROVIDER_API_KEY: the API key for whichever provider is approved.
EMAIL_PROVIDER_API_KEY=
# CONTACT_RECIPIENT_EMAIL: the verified NUVAIX GROUP mailbox that should
# receive general enquiries. Never hardcode this in source; only ever read
# from this environment variable.
CONTACT_RECIPIENT_EMAIL=
